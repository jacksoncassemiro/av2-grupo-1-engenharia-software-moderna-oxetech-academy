# Copie para .env  ->  cp .env.example .env
# O docker compose le este arquivo automaticamente.

# ---------- Banco de dados ----------
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_DB=clinica_db
POSTGRES_PORT=5433

# Usada pelo backend RODANDO FORA do Docker (dev local sem container):
DATABASE_URL=postgresql+psycopg://clinica:clinica@localhost:5433/clinica_db

# ---------- Aplicacao ----------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---------- Seguranca (RN11/RN13) ----------
# Gere uma chave nova:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_EXPIRE_MINUTES=1440

# ---------- Regras de negocio parametrizaveis ----------
CANCELAMENTO_ANTECEDENCIA_HORAS=24
TIMEZONE=America/Maceio

# ---------- Bootstrap do primeiro atendente (ADR-004) ----------
# Usado APENAS pelo seed. Troque a senha antes da apresentacao.
SEED_ATENDENTE_NOME=Atendente Padrao
SEED_ATENDENTE_LOGIN=recepcao@clinica.com
SEED_ATENDENTE_SENHA=admin123

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=/api
