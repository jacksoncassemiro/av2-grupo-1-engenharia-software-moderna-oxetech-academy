# ══════════════════════════════════════════════════════════════════════
#  cp .env.example .env    →  e pronto. Nao precisa editar nada.
#
#  ATENCAO: os valores abaixo sao de DESENVOLVIMENTO/AVALIACAO. Servem
#  para qualquer pessoa da equipe subir o projeto identico em 1 comando.
#  Nunca coloque credencial real aqui — o arquivo vai pro Git.
#  O `.env` (com dados reais, se um dia houver) esta no .gitignore.
#
#  Se um dia isso for pra producao: gere um JWT_SECRET_KEY novo com
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#  e troque a senha do seed.
# ══════════════════════════════════════════════════════════════════════

# ---------- Banco de dados ----------
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_DB=clinica_db
POSTGRES_PORT=5433

# Usada pelo backend rodando FORA do Docker (dev local sem container).
# Dentro do Docker o compose sobrescreve com host=postgres, porta 5432.
DATABASE_URL=postgresql+psycopg://clinica:clinica@localhost:5433/clinica_db

# ---------- Aplicacao ----------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---------- Seguranca (RN11 / RN13) ----------
# Chave fixa de DEV para que os tokens continuem validos entre restarts
# e todo mundo da equipe tenha o mesmo comportamento.
JWT_SECRET_KEY=dev-only-av2-equipe01-nao-usar-em-producao-6f3b91c4e2
JWT_EXPIRE_MINUTES=1440

# ---------- Regras de negocio parametrizaveis ----------
# RN04 - antecedencia minima para o paciente cancelar.
# Baixe para 0 se precisar demonstrar o cancelamento sem esperar.
CANCELAMENTO_ANTECEDENCIA_HORAS=24
# RN15 - fuso de referencia de todas as regras temporais.
TIMEZONE=America/Maceio

# ---------- Bootstrap do primeiro atendente (ADR-004) ----------
# Usado APENAS pelo seed, que e idempotente. Este e o login da
# apresentacao: sem ele ninguem cadastra medico/paciente/especialidade.
SEED_ATENDENTE_NOME=Atendente Padrao
SEED_ATENDENTE_LOGIN=recepcao@clinica.com
SEED_ATENDENTE_SENHA=admin123

# ---------- Frontend ----------
# O Next faz proxy de /api para o backend (ver next.config.mjs).
NEXT_PUBLIC_API_URL=/api
